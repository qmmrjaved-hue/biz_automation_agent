# Copy this file to .env and fill in what you have. Every integration
# degrades gracefully / is skippable except GEMINI_API_KEY, which powers
# every "smart" step (extraction, classification, drafting, SQL generation).

# ── LLM (required) ──────────────────────────────────────────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ── Safety ───────────────────────────────────────────────────────────────────
# When true (default), sending email/WhatsApp or calling the custom REST API
# only logs what WOULD be sent instead of actually sending it.
DRY_RUN=true

# ── Storage ──────────────────────────────────────────────────────────────────
# Default sink for document_processing/etl when not specified explicitly:
# excel | sheets | postgres | sqlite
SINK=excel
DATA_DIR=data
MEMORY_DB_PATH=data/agent.db
EXCEL_PATH=data/records.xlsx
WAREHOUSE_DB_PATH=data/warehouse.db

# ── Postgres (optional) ──────────────────────────────────────────────────────
POSTGRES_DSN=

# ── Google Sheets (optional) ─────────────────────────────────────────────────
SHEETS_CREDENTIALS_PATH=
SHEETS_SPREADSHEET_ID=

# ── Email — IMAP read / SMTP send (optional) ─────────────────────────────────
IMAP_HOST=
IMAP_USER=
IMAP_PASSWORD=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# category:email pairs, comma-separated — where email_automation routes each category
ROUTING_MAP=fatturazione:billing@example.com,assistenza:support@example.com,logistica:logistics@example.com,appuntamento:frontdesk@example.com,altro:info@example.com

# ── WhatsApp Cloud API (optional) ────────────────────────────────────────────
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# ── Custom CRM / logistics REST API (optional) ───────────────────────────────
CUSTOM_API_BASE_URL=
CUSTOM_API_KEY=
